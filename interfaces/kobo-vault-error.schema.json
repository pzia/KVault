{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kobo-vault.local/schemas/error-v2.json",
  "title": "Kobo Vault API Error",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
